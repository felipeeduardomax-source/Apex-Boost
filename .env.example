# ==============================================================
# CONFIGURAÇÃO DE BANCO DE DADOS NEON (POSTGRESQL)
# ==============================================================
# Cole aqui a string de conexão copiada do seu painel na Neon.tech:
# Exemplo:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxxx@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=
SECRET_KEY=apex_boost_secret_key_ultra_secure_2026_gamer

# ==============================================================
# CONFIGURAÇÃO DE LOGIN SOCIAL (OAUTH) - DISCORD & GOOGLE
# ==============================================================
# Opcional: Se preenchidos, ativam o redirecionamento OAuth oficial.
# Se deixados vazios, o sistema utiliza autenticação ágil de 1 clique
# permitindo testes imediatos sem fricção nem erros.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/login/discord/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/login/google/callback

